        "heading_mK89pN": {
          "type": "heading",
          "settings": {
            "heading": "Built for two voices, not one performer",
            "heading_size": "h1"
          }
        },
        "text_Hd7aj4": {
          "type": "text",
          "settings": {
            "text": "<p>Filming with someone else is where phone audio usually falls apart. One mic means one clear voice and one distant guest. DUET gives both people their own microphone, feeding a single receiver connected straight to your phone. No app, no Bluetooth pairing, just plug in and go.</p>",
            "text_style": "body"
          }
        },
