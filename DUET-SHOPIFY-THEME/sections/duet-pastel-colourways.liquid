{%- style -%}
  .dpc { background: var(--s-bg, #fff); color: var(--s-fg, #1C1517); padding-block: var(--s-pt, 72px) var(--s-pb, 72px); }
  .dpc__head { text-align: var(--ha, center); max-width: 64rem; margin: 0 auto 4rem; }
  .dpc__head h2 { font-size: clamp(calc(var(--hs, 68) * 0.59px), calc(var(--hs, 68) * 0.0882vw), calc(var(--hs, 68) * 1px)) !important; line-height: 1 !important; margin: 0 0 1.2rem; }
  .dpc__head h2 em { font-style: italic; }
  .dpc__head p { font-size: 1.7rem; margin: 0; }
  .dpc__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2.4rem; }
  .dpc__tile { display: grid; gap: 1.6rem; padding: 1.6rem 1.6rem 2.4rem; border-radius: 28px; text-decoration: none; color: var(--duet-ink, #1C1517); transition: transform 220ms ease; }
  .dpc__tile:hover { transform: translateY(-4px); }
  .dpc__media { border-radius: 20px; overflow: hidden; aspect-ratio: 4 / 5; }
  .dpc__media img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 320ms ease; }
  .dpc__tile:hover .dpc__media img { transform: scale(1.03); }
  .dpc__row { display: flex; justify-content: space-between; align-items: flex-end; gap: 1rem; padding-inline: 0.8rem; }
  html body .dpc__name { font-family: "Instrument Serif", Georgia, "Times New Roman", serif !important; font-weight: 400 !important; font-style: italic; font-size: 4.4rem; line-height: 0.9; margin: 0; }
  html body .dpc__sub { font-family: "Figtree", system-ui, sans-serif !important; font: 600 1.2rem/1.2 var(--duet-sans); letter-spacing: 0.16em; text-transform: uppercase; margin: 0 0 0.6rem; }
  .dpc__cta { font: 600 1.4rem/1 var(--duet-sans); padding: 1.1rem 1.6rem; border-radius: 999px; background: var(--duet-ink, #1C1517); color: var(--duet-cream, #FFF6F1); white-space: nowrap; }
  @media screen and (max-width: 989px) {
    .dpc__grid { grid-template-columns: repeat(3, minmax(26rem, 1fr)); overflow-x: auto; scroll-snap-type: x mandatory; padding-bottom: 1.2rem; }
    .dpc__tile { scroll-snap-align: start; }
  }
  @media screen and (max-width: 480px) {
    .dpc { padding-block: calc(var(--s-pt) * 0.75) calc(var(--s-pb) * 0.75); }
    .dpc__grid { grid-template-columns: repeat(3, 80%); gap: 1.6rem; }
    .dpc__name { font-size: 3.6rem; }
  }
  @media (prefers-reduced-motion: reduce) { .dpc__tile, .dpc__media img { transition: none; } .dpc__tile:hover { transform: none; } .dpc__tile:hover .dpc__media img { transform: none; } }
{%- endstyle -%}

<section class="dpc" style="--s-bg: {{ section.settings.s_bg }}; --s-fg: {{ section.settings.s_fg }}; --s-pt: {{ section.settings.s_pt }}px; --s-pb: {{ section.settings.s_pb }}px; --hs: {{ section.settings.heading_size }}; --ha: {{ section.settings.heading_align }};" aria-labelledby="dpc-title-{{ section.id }}">
  <div class="page-width">
    <div class="dpc__head">
      <h2 id="dpc-title-{{ section.id }}">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}
    </div>
    <div class="dpc__grid">
      {%- for block in section.blocks -%}
        <a class="dpc__tile" href="{{ block.settings.link | default: routes.all_products_collection_url }}" style="background: {{ block.settings.bg }};" {{ block.shopify_attributes }}>
          <div class="dpc__media">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '400, 600, 900', sizes: '(min-width: 990px) 30vw, 80vw' }}
            {%- endif -%}
          </div>
          <div class="dpc__row">
            <div>
              <p class="dpc__sub">{{ block.settings.sub }}</p>
              <p class="dpc__name">{{ block.settings.name }}</p>
            </div>
            <span class="dpc__cta">{{ block.settings.cta }}</span>
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "DUET colourways",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Blush, Cloud or <em>Noir?</em>"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "Three colours. The same tiny mics. Which one's you?"
    },
    {
      "type": "header",
      "content": "Section style"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size (desktop)",
      "min": 28,
      "max": 140,
      "step": 4,
      "unit": "px",
      "default": 68
    },
    {
      "type": "select",
      "id": "heading_align",
      "label": "Heading alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Centre"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "color",
      "id": "s_bg",
      "label": "Background colour",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "s_fg",
      "label": "Text colour",
      "default": "#1C1517"
    },
    {
      "type": "range",
      "id": "s_pt",
      "label": "Space above",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "s_pb",
      "label": "Space below",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 72
    }
  ],
  "blocks": [
    {
      "type": "colour",
      "name": "Colourway",
      "settings": [
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": "Blush"
        },
        {
          "type": "text",
          "id": "sub",
          "label": "Label",
          "default": "Pink"
        },
        {
          "type": "text",
          "id": "cta",
          "label": "Button text",
          "default": "Shop"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "color",
          "id": "bg",
          "label": "Tile colour",
          "default": "#F7C6D6"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "DUET colourways"
    }
  ]
}
{% endschema %}
