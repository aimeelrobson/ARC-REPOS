{%- style -%}
  .dpu { background: var(--s-bg, #FDD3B8); color: var(--s-fg, #1C1517); padding-block: var(--s-pt, 72px) var(--s-pb, 72px); }
  .dpu__head { display: flex; justify-content: space-between; align-items: flex-end; gap: 2.4rem; flex-wrap: wrap; margin-bottom: 3.6rem; }
  .dpu__head h2 { font-size: clamp(calc(var(--hs, 68) * 0.59px), calc(var(--hs, 68) * 0.0882vw), calc(var(--hs, 68) * 1px)) !important; line-height: 1 !important; margin: 0; max-width: 18ch; }
  .dpu__head h2 em { font-style: italic; }
  .dpu__head p { font-size: 1.7rem; margin: 0; max-width: 38rem; }
  .dpu__grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 2rem; }
  .dpu__card { position: relative; display: block; color: var(--duet-ink, #1C1517); text-decoration: none; }
  .dpu__media { border-radius: 24px; overflow: hidden; aspect-ratio: 4 / 5; }
  .dpu__media img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 320ms ease; }
  .dpu__card:hover .dpu__media img { transform: scale(1.03); }
  .dpu__sticker { position: absolute; left: 1.4rem; bottom: 1.4rem; font-family: "Instrument Serif", Georgia, serif; border-radius: 999px !important; font-style: italic; font-size: 2.6rem; line-height: 1; padding: 1rem 1.8rem 1.2rem; border-radius: 16px; box-shadow: 0 10px 24px rgba(28, 21, 23, 0.16); }
  @media screen and (max-width: 989px) {
    .dpu__grid { grid-template-columns: repeat(4, 42%); overflow-x: auto; scroll-snap-type: x mandatory; padding-bottom: 1.2rem; }
    .dpu__card { scroll-snap-align: start; }
  }
  @media screen and (max-width: 480px) {
    .dpu { padding-block: calc(var(--s-pt) * 0.75) calc(var(--s-pb) * 0.75); }
    .dpu__grid { grid-template-columns: repeat(4, 72%); gap: 1.4rem; }
    .dpu__sticker { font-size: 2.2rem; }
  }
  @media (prefers-reduced-motion: reduce) { .dpu__media img { transition: none; } .dpu__card:hover .dpu__media img { transform: none; } }
{%- endstyle -%}

<section class="dpu" style="--s-bg: {{ section.settings.s_bg }}; --s-fg: {{ section.settings.s_fg }}; --s-pt: {{ section.settings.s_pt }}px; --s-pb: {{ section.settings.s_pb }}px; --hs: {{ section.settings.heading_size }};" aria-labelledby="dpu-title-{{ section.id }}">
  <div class="page-width">
    <div class="dpu__head">
      <h2 id="dpu-title-{{ section.id }}">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}
    </div>
    <div class="dpu__grid">
      {%- for block in section.blocks -%}
        <a class="dpu__card" href="{{ block.settings.link | default: routes.all_products_collection_url }}" {{ block.shopify_attributes }}>
          <div class="dpu__media">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '400, 600, 800', sizes: '(min-width: 990px) 24vw, 72vw' }}
            {%- endif -%}
          </div>
          <span class="dpu__sticker" style="background: {{ block.settings.sticker_bg }};">{{ block.settings.label }}</span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "DUET use cases",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Made for the way <em>you</em> film"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "If there are two of you talking, there should be two mics."
    },
    {
      "type": "header",
      "content": "Section style"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size (desktop)",
      "min": 28,
      "max": 140,
      "step": 4,
      "unit": "px",
      "default": 68
    },
    {
      "type": "color",
      "id": "s_bg",
      "label": "Background colour",
      "default": "#FDD3B8"
    },
    {
      "type": "color",
      "id": "s_fg",
      "label": "Text colour",
      "default": "#1C1517"
    },
    {
      "type": "range",
      "id": "s_pt",
      "label": "Space above",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "s_pb",
      "label": "Space below",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 72
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Use case",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Sticker text",
          "default": "podcasts."
        },
        {
          "type": "color",
          "id": "sticker_bg",
          "label": "Sticker colour",
          "default": "#F7C6D6"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "DUET use cases"
    }
  ]
}
{% endschema %}
