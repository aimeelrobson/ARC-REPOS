{%- style -%}
  .dph { position: relative; background: var(--s-bg, #CDEBDD); color: var(--s-fg, #1C1517); overflow: hidden; }
  .dph__stage { position: relative; min-height: var(--hh, 80vh); display: flex; align-items: var(--v, center); }
  .dph__img { position: absolute; inset: 0; }
  .dph__img img { width: 100%; height: 100%; object-fit: cover; object-position: var(--fx, 70%) var(--fy, 40%); display: block; }
  .dph__img::after { content: ""; position: absolute; inset: 0; background: rgba(28, 21, 23, var(--ov, 0)); pointer-events: none; }
  .dph__img--mobile { display: none; }
  .dph__wrap { position: relative; z-index: 2; width: 100%; display: flex; justify-content: var(--h, flex-start); padding-block: var(--pad, 80px); }
  .dph__copy { width: 100%; max-width: var(--cw, 56rem); display: flex; flex-wrap: wrap; align-items: center; column-gap: 1.2rem; justify-content: var(--jc, flex-start); text-align: var(--ta, left); }
  .dph__copy > .dph__title, .dph__copy > .dph__text { flex: 0 0 100%; }
  .dph__title { font-family: "Instrument Serif", Georgia, "Times New Roman", serif !important; font-weight: 400 !important; font-size: clamp(calc(var(--hs, 136) * 0.44px), calc(var(--hs, 136) * 0.07vw), calc(var(--hs, 136) * 1px)) !important; line-height: 0.88 !important; letter-spacing: -0.02em; margin: 0 0 var(--mb, 28px); text-wrap: balance; color: var(--bc, inherit); }
  .dph__title em { font-style: italic; }
  .dph__text { font-size: calc(var(--ts, 18) * 1px); line-height: 1.45; margin: 0 0 var(--mb, 24px); color: var(--bc, inherit); }
  .dph__text p { margin: 0; }
  .dph__btn { display: inline-flex; align-items: center; justify-content: center; min-height: 5.6rem; padding: 0 3.6rem; border-radius: 999px; border: 2px solid transparent; background: var(--duet-ink, #1C1517); color: var(--duet-cream, #FFF6F1); font: 600 1.5rem/1 "Figtree", system-ui, sans-serif; letter-spacing: 0.03em; text-decoration: none; margin-bottom: 1.2rem; transition: background-color 180ms ease, color 180ms ease, transform 180ms ease; }
  .dph__btn--large { min-height: 6.4rem; padding: 0 4.4rem; font-size: 1.7rem; }
  .dph__btn--small { min-height: 4.6rem; padding: 0 2.6rem; font-size: 1.4rem; }
  .dph__btn--pink { background: var(--duet-hotpink, #FF7EB3); color: var(--duet-ink, #1C1517); }
  .dph__btn--white { background: #fff; color: var(--duet-ink, #1C1517); }
  .dph__btn--outline { background: transparent; color: currentColor; border-color: currentColor; }
  .dph__btn:hover { background: var(--duet-hotpink, #FF7EB3); color: var(--duet-ink, #1C1517); border-color: transparent; transform: translateY(-2px); }
  .dph__btn--pink:hover { background: var(--duet-ink, #1C1517); color: var(--duet-cream, #FFF6F1); }
  .dph__float { position: absolute; z-index: 3; font: 600 1.5rem/1 "Figtree", system-ui, sans-serif; padding: 1.3rem 2.2rem; border-radius: 999px; background: var(--s-pill, #F7C6D6); color: var(--duet-ink, #1C1517); box-shadow: 0 14px 30px -10px rgba(28, 21, 23, 0.35); animation: dph-float 4.5s ease-in-out infinite; white-space: nowrap; }
  .dph__float--top-right { right: 6%; top: 14%; }
  .dph__float--top-left { left: 6%; top: 14%; }
  .dph__float--bottom-right { right: 6%; bottom: 14%; }
  .dph__float--bottom-left { left: 6%; bottom: 14%; }
  @keyframes dph-float { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-10px); } }

  .dph__ticker { position: relative; z-index: 2; background: var(--s-tick-bg, #1C1517); color: var(--s-tick-fg, #FFF6F1); overflow: hidden; white-space: nowrap; }
  .dph__track { display: inline-flex; gap: 0; padding-block: 1.6rem; animation: dph-scroll 32s linear infinite; }
  .dph__track span { font: 600 1.4rem/1 "Figtree", system-ui, sans-serif; letter-spacing: 0.14em; text-transform: uppercase; padding-inline: 2.4rem; display: inline-flex; align-items: center; gap: 2.4rem; }
  .dph__track span::after { content: "✶"; color: var(--duet-bubblegum, #F7C6D6); }
  @keyframes dph-scroll { from { transform: translateX(0); } to { transform: translateX(-50%); } }
  .dph__ticker:hover .dph__track { animation-play-state: paused; }

  @media screen and (max-width: 749px) {
    .dph__stage { display: block; min-height: 0; }
    .dph__img { position: relative; inset: auto; aspect-ratio: var(--mr, 4 / 5); }
    .dph__img--desktop { display: none; }
    .dph__img--mobile { display: block; }
    .dph__img--mobile img { object-position: var(--mfx, 50%) var(--mfy, 35%); }
    .dph__wrap { padding-block: 3.6rem 4.4rem; background: var(--s-mob, #F7C6D6); }
    .dph__copy { max-width: none; justify-content: var(--mjc, flex-start); text-align: var(--mta, left); }
    .dph__title { font-size: min(calc(var(--hsm, 72) * 1px), 15vw) !important; margin-bottom: min(var(--mb, 24px), 24px); }
    .dph__text { font-size: max(15px, calc(var(--ts, 18) * 0.9px)); }
    .dph__btn { flex: 1 1 100%; }
    .dph__float { font-size: 1.3rem; padding: 1.1rem 1.8rem; top: 3.2rem; bottom: auto; }
    .dph__float--top-right, .dph__float--bottom-right { right: 1.6rem; left: auto; }
    .dph__float--top-left, .dph__float--bottom-left { left: 1.6rem; right: auto; }
  }
  @media (prefers-reduced-motion: reduce) {
    .dph__float, .dph__track { animation: none; }
    .dph__btn { transition: none; }
    .dph__btn:hover { transform: none; }
  }
{%- endstyle -%}

{%- liquid
  case section.settings.h_pos
    when 'center'
      assign h = 'center'
    when 'right'
      assign h = 'flex-end'
    else
      assign h = 'flex-start'
  endcase
  case section.settings.v_pos
    when 'top'
      assign v = 'flex-start'
    when 'bottom'
      assign v = 'flex-end'
    else
      assign v = 'center'
  endcase
  case section.settings.align
    when 'center'
      assign jc = 'center'
    when 'right'
      assign jc = 'flex-end'
    else
      assign jc = 'flex-start'
  endcase
  if section.settings.mobile_align == 'center'
    assign mjc = 'center'
  else
    assign mjc = 'flex-start'
  endif
  case section.settings.mobile_ratio
    when 'square'
      assign mr = '1 / 1'
    when 'tall'
      assign mr = '2 / 3'
    when 'landscape'
      assign mr = '4 / 3'
    else
      assign mr = '4 / 5'
  endcase
  assign ov = section.settings.overlay | divided_by: 100.0
-%}

<section class="dph" style="--s-bg: {{ section.settings.s_bg }}; --s-fg: {{ section.settings.s_fg }}; --s-pill: {{ section.settings.s_pill }}; --s-tick-bg: {{ section.settings.s_tick_bg }}; --s-tick-fg: {{ section.settings.s_tick_fg }}; --s-mob: {{ section.settings.s_mob }}; --hh: {{ section.settings.height }}vh; --h: {{ h }}; --v: {{ v }}; --jc: {{ jc }}; --ta: {{ section.settings.align }}; --mjc: {{ mjc }}; --mta: {{ section.settings.mobile_align }}; --cw: {{ section.settings.copy_width }}rem; --pad: {{ section.settings.edge_space }}px; --fx: {{ section.settings.focus_x }}%; --fy: {{ section.settings.focus_y }}%; --mfx: {{ section.settings.m_focus_x }}%; --mfy: {{ section.settings.m_focus_y }}%; --mr: {{ mr }}; --ov: {{ ov }};" aria-labelledby="dph-title-{{ section.id }}">
  <div class="dph__stage">
    {%- if section.settings.image != blank -%}
      <div class="dph__img dph__img--desktop">
        {{ section.settings.image | image_url: width: 2400 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '900, 1400, 1900, 2400', sizes: '100vw', alt: section.settings.image.alt }}
      </div>
    {%- endif -%}
    {%- assign mobile_img = section.settings.image_mobile | default: section.settings.image -%}
    {%- if mobile_img != blank -%}
      <div class="dph__img dph__img--mobile">
        {{ mobile_img | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '500, 750, 1000', sizes: '100vw', alt: mobile_img.alt }}
      </div>
    {%- endif -%}
    {%- if section.settings.float_text != blank -%}<span class="dph__float dph__float--{{ section.settings.float_pos }}">{{ section.settings.float_text }}</span>{%- endif -%}
    <div class="dph__wrap page-width">
      <div class="dph__copy">
        {%- if section.blocks.size > 0 -%}
          {%- assign used_h1 = false -%}
          {%- for block in section.blocks -%}
            {%- assign bc = 'inherit' -%}
            {%- if block.settings.colour != blank and block.settings.colour != 'rgba(0,0,0,0)' -%}{%- assign bc = block.settings.colour -%}{%- endif -%}
            {%- case block.type -%}
              {%- when 'heading' -%}
                {%- if used_h1 -%}
                  <h2 class="dph__title" style="--hs: {{ block.settings.size }}; --hsm: {{ block.settings.size_mobile }}; --mb: {{ block.settings.space_below }}px; --bc: {{ bc }};" {{ block.shopify_attributes }}>{{ block.settings.heading }}</h2>
                {%- else -%}
                  {%- assign used_h1 = true -%}
                  <h1 class="dph__title" id="dph-title-{{ section.id }}" style="--hs: {{ block.settings.size }}; --hsm: {{ block.settings.size_mobile }}; --mb: {{ block.settings.space_below }}px; --bc: {{ bc }};" {{ block.shopify_attributes }}>{{ block.settings.heading }}</h1>
                {%- endif -%}
              {%- when 'text' -%}
                <div class="dph__text" style="--ts: {{ block.settings.size }}; --mb: {{ block.settings.space_below }}px; --bc: {{ bc }};" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
              {%- when 'button' -%}
                {%- if block.settings.label != blank -%}
                  <a class="dph__btn dph__btn--{{ block.settings.style }} dph__btn--{{ block.settings.size }}" href="{{ block.settings.link | default: routes.all_products_collection_url }}" {{ block.shopify_attributes }}>{{ block.settings.label }}</a>
                {%- endif -%}
            {%- endcase -%}
          {%- endfor -%}
        {%- else -%}
          <h1 class="dph__title" id="dph-title-{{ section.id }}">{{ section.settings.heading }}</h1>
          {%- if section.settings.button_label != blank -%}
            <a class="dph__btn" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label }}</a>
          {%- endif -%}
        {%- endif -%}
      </div>
    </div>
  </div>
  {%- assign items = section.settings.ticker | split: '|' -%}
  {%- if items.size > 0 -%}
    <div class="dph__ticker" aria-label="{{ section.settings.ticker | replace: '|', ', ' | escape }}">
      <div class="dph__track" aria-hidden="true">
        {%- for n in (1..2) -%}{%- for item in items -%}<span>{{ item | strip }}</span>{%- endfor -%}{%- for item in items -%}<span>{{ item | strip }}</span>{%- endfor -%}{%- endfor -%}
      </div>
    </div>
  {%- endif -%}
</section>

