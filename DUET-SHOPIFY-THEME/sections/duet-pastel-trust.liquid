{%- style -%}
  .dpt { background: var(--s-bg, #1C1517); color: var(--s-fg, #FFF6F1); padding-block: var(--s-pt, 72px) var(--s-pb, 72px); }
  .dpt__title { text-align: var(--ha, left); font-family: "Instrument Serif", Georgia, "Times New Roman", serif !important; font-weight: 400 !important; font-size: clamp(calc(var(--hs, 56) * 0.643px), calc(var(--hs, 56) * 0.0893vw), calc(var(--hs, 56) * 1px)) !important; line-height: 1 !important; color: var(--s-fg, #FFF6F1); margin: 0 0 3.6rem; text-wrap: balance; }
  .dpt__grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.6rem; }
  .dpt__card { border-radius: 24px; padding: 2.8rem 2.4rem; color: var(--duet-ink, #1C1517); display: grid; gap: 0.8rem; align-content: start; }
  .dpt__card h3 { font-family: "Instrument Serif", Georgia, "Times New Roman", serif !important; font-weight: 400 !important; font-size: 2.8rem !important; line-height: 1.05 !important; margin: 0; color: var(--duet-ink, #1C1517); }
  .dpt__card p { margin: 0; font-size: 1.5rem; line-height: 1.4; color: var(--duet-ink, #1C1517); }
  @media screen and (max-width: 989px) { .dpt__grid { grid-template-columns: repeat(2, 1fr); } }
  @media screen and (max-width: 480px) { .dpt { padding-block: calc(var(--s-pt) * 0.75) calc(var(--s-pb) * 0.75); } .dpt__card { padding: 2rem 1.6rem; } .dpt__card h3 { font-size: 2.2rem !important; } }
{%- endstyle -%}

<section class="dpt" style="--s-bg: {{ section.settings.s_bg }}; --s-fg: {{ section.settings.s_fg }}; --s-pt: {{ section.settings.s_pt }}px; --s-pb: {{ section.settings.s_pb }}px; --hs: {{ section.settings.heading_size }}; --ha: {{ section.settings.heading_align }};" aria-labelledby="dpt-title-{{ section.id }}">
  <div class="page-width">
    <h2 class="dpt__title" id="dpt-title-{{ section.id }}">{{ section.settings.heading }}</h2>
    <ul class="dpt__grid">
      {%- for block in section.blocks -%}
        <li class="dpt__card" style="background: {{ block.settings.bg }};" {{ block.shopify_attributes }}>
          <h3>{{ block.settings.title }}</h3>
          {%- if block.settings.text != blank -%}<p>{{ block.settings.text }}</p>{%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "DUET trust bar",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Everything you need. Nothing you don’t."
    },
    {
      "type": "header",
      "content": "Section style"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size (desktop)",
      "min": 28,
      "max": 140,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "select",
      "id": "heading_align",
      "label": "Heading alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Centre"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "color",
      "id": "s_bg",
      "label": "Background colour",
      "default": "#1C1517"
    },
    {
      "type": "color",
      "id": "s_fg",
      "label": "Text colour",
      "default": "#FFF6F1"
    },
    {
      "type": "range",
      "id": "s_pt",
      "label": "Space above",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "s_pb",
      "label": "Space below",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 72
    }
  ],
  "blocks": [
    {
      "type": "promise",
      "name": "Promise",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Free NZ shipping"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "On every order"
        },
        {
          "type": "color",
          "id": "bg",
          "label": "Card colour",
          "default": "#F7C6D6"
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "DUET trust bar"
    }
  ]
}
{% endschema %}
